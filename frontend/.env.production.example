# URL pública del backend en producción (con /api al final, sin barra extra).
# Vite incrusta esta variable en el bundle en tiempo de build, así que hay
# que definirla ANTES de correr `npm run build`, no después.
# En el VPS todo-en-uno el API vive en el mismo dominio del portal (Nginx
# reenvía /api al backend), por eso es el mismo host que el frontend.
# Copia este archivo como frontend/.env.production antes del build.
VITE_API_URL=https://portal.liceosanmarcos.edu.co/api
