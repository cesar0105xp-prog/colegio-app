generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Rol {
  ADMINISTRADOR
  SECRETARIO
  PROFESOR
  PADRE
  ESTUDIANTE
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum TipoDocumento {
  CC
  TI
  RC
  CE
  PASAPORTE
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
}

enum EstadoEstudiante {
  ACTIVO
  INACTIVO
  RETIRADO
  GRADUADO
}

enum TipoActividad {
  TAREA
  TALLER
  EXAMEN
  QUIZ
  PROYECTO
  EXPOSICION
  PARTICIPACION
}

enum TipoObservacion {
  POSITIVA
  NEGATIVA
  NEUTRA
  DISCIPLINARIA
  ACADEMICA
  CONVIVENCIA
}

enum TipoDocumentoArchivo {
  BOLETIN
  CERTIFICADO
  AUTORIZACION
  OTRO
}

enum AccionAuditoria {
  LOGIN
  LOGOUT
  CREAR
  EDITAR
  ELIMINAR
  VER
  SUBIR_ARCHIVO
  DESCARGAR_ARCHIVO
  MARCAR_VISTO
  CAMBIO_CONTRASENA
  LOGIN_FALLIDO
  BLOQUEO_CUENTA
}

// ─── USUARIOS ────────────────────────────────────────────────────────────────

model Usuario {
  id                    String        @id @default(uuid())
  email                 String        @unique
  passwordHash          String        @map("password_hash")
  rol                   Rol
  estado                EstadoUsuario @default(ACTIVO)
  intentosFallidos      Int           @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime?     @map("bloqueado_hasta")
  ultimoLogin           DateTime?     @map("ultimo_login")
  tokenResetPassword    String?       @map("token_reset_password")
  tokenResetExpira      DateTime?     @map("token_reset_expira")
  refreshToken          String?       @map("refresh_token")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  matriculasVerificadas Matricula[]   @relation("MatriculasVerificadas")

  // Relaciones
  perfilAdmin      Administrador?
  perfilSecretario Secretario?
  perfilProfesor   Profesor?
  perfilPadre      Padre?
  perfilEstudiante Estudiante?
  auditLogs        AuditLog[]
  comunicados      Comunicado[]   @relation("ComunicadosCreadosPor")

  @@map("usuarios")
}

// ─── PERFILES POR ROL ────────────────────────────────────────────────────────

model Administrador {
  id        String   @id @default(uuid())
  usuarioId String   @unique @map("usuario_id")
  nombres   String
  apellidos String
  telefono  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("administradores")
}

model Secretario {
  id        String   @id @default(uuid())
  usuarioId String   @unique @map("usuario_id")
  nombres   String
  apellidos String
  telefono  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("secretarios")
}

model Profesor {
  id              String        @id @default(uuid())
  usuarioId       String        @unique @map("usuario_id")
  nombres         String
  apellidos       String
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @unique @map("numero_documento")
  telefono        String
  especialidad    String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  usuario       Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materiaGrados MateriaGradoProfesor[]
  actividades   Actividad[]
  observaciones Observacion[]

  @@map("profesores")
}

model Padre {
  id              String        @id @default(uuid())
  usuarioId       String        @unique @map("usuario_id")
  nombres         String
  apellidos       String
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @unique @map("numero_documento")
  telefono        String
  telefonoAlt     String?       @map("telefono_alt")
  direccion       String?
  ocupacion       String?
  emailContacto   String?       @map("email_contacto")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  usuario             Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hijos               PadreEstudiante[]
  matriculas          Matricula[]
  observacionesVistas ObservacionVista[]
  archivosSubidos     Archivo[]

  @@map("padres")
}

// ─── ESTUDIANTES ─────────────────────────────────────────────────────────────

model Estudiante {
  id               String            @id @default(uuid())
  usuarioId        String?           @unique @map("usuario_id")
  nombres          String
  apellidos        String
  tipoDocumento    TipoDocumento     @map("tipo_documento")
  numeroDocumento  String            @unique @map("numero_documento")
  fechaNacimiento  DateTime          @map("fecha_nacimiento")
  genero           Genero
  direccion        String?
  telefono         String?
  matricula        Matricula?
  estado           EstadoEstudiante  @default(ACTIVO)
  foto             String?
  gradoId          String            @map("grado_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  codigoMatricula  String?           @unique @map("codigo_matricula")
  datosAdicionales DatosAdicionales?

  usuario             Usuario?             @relation(fields: [usuarioId], references: [id])
  grado               Grado                @relation(fields: [gradoId], references: [id])
  padres              PadreEstudiante[]
  calificaciones      Calificacion[]
  observaciones       Observacion[]
  archivos            Archivo[]
  contactosEmergencia ContactoEmergencia[]

  @@map("estudiantes")
}

model PadreEstudiante {
  id           String   @id @default(uuid())
  padreId      String   @map("padre_id")
  estudianteId String   @map("estudiante_id")
  parentesco   String // padre, madre, acudiente, abuelo, tio, etc.
  esPrincipal  Boolean  @default(false) @map("es_principal")
  createdAt    DateTime @default(now()) @map("created_at")

  padre      Padre      @relation(fields: [padreId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([padreId, estudianteId])
  @@map("padres_estudiantes")
}

// ─── ESTRUCTURA ACADÉMICA ────────────────────────────────────────────────────

model Grado {
  id        String   @id @default(uuid())
  nombre    String // "5°", "6°", "11°"
  grupo     String // "A", "B", "C"
  nivel     String // "primaria", "secundaria", "media"
  anio      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estudiantes   Estudiante[]
  materiaGrados MateriaGradoProfesor[]
  comunicados   Comunicado[]
  actividades   Actividad[]

  @@unique([nombre, grupo, anio])
  @@map("grados")
}

model Materia {
  id        String   @id @default(uuid())
  nombre    String   @unique
  codigo    String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  materiaGrados MateriaGradoProfesor[]
  actividades   Actividad[]
  observaciones Observacion[]

  @@map("materias")
}

model Periodo {
  id          String   @id @default(uuid())
  nombre      String // "Período 1", "Período 2", etc.
  numero      Int // 1, 2, 3, 4
  anio        Int
  fechaInicio DateTime @map("fecha_inicio")
  fechaFin    DateTime @map("fecha_fin")
  activo      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  actividades Actividad[]

  @@unique([numero, anio])
  @@map("periodos")
}

model MateriaGradoProfesor {
  id         String   @id @default(uuid())
  materiaId  String   @map("materia_id")
  gradoId    String   @map("grado_id")
  profesorId String   @map("profesor_id")
  anio       Int
  createdAt  DateTime @default(now()) @map("created_at")

  materia  Materia  @relation(fields: [materiaId], references: [id])
  grado    Grado    @relation(fields: [gradoId], references: [id])
  profesor Profesor @relation(fields: [profesorId], references: [id])

  @@unique([materiaId, gradoId, anio])
  @@map("materia_grado_profesor")
}

// ─── NOTAS Y ACTIVIDADES ─────────────────────────────────────────────────────

model Actividad {
  id           String        @id @default(uuid())
  nombre       String
  tipo         TipoActividad
  porcentaje   Decimal       @db.Decimal(5, 2) // suma por periodo+materia+grado debe = 100
  descripcion  String?
  fechaEntrega DateTime?     @map("fecha_entrega")
  materiaId    String        @map("materia_id")
  gradoId      String        @map("grado_id")
  periodoId    String        @map("periodo_id")
  profesorId   String        @map("profesor_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  materia        Materia        @relation(fields: [materiaId], references: [id])
  grado          Grado          @relation(fields: [gradoId], references: [id])
  periodo        Periodo        @relation(fields: [periodoId], references: [id])
  profesor       Profesor       @relation(fields: [profesorId], references: [id])
  calificaciones Calificacion[]

  @@map("actividades")
}

model Calificacion {
  id            String   @id @default(uuid())
  actividadId   String   @map("actividad_id")
  estudianteId  String   @map("estudiante_id")
  valor         Decimal  @db.Decimal(5, 2) // 0.00 – 100.00
  observacion   String?
  fechaRegistro DateTime @default(now()) @map("fecha_registro")
  updatedAt     DateTime @updatedAt @map("updated_at")

  actividad  Actividad  @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([actividadId, estudianteId])
  @@map("calificaciones")
}

// ─── OBSERVADOR ──────────────────────────────────────────────────────────────

model Observacion {
  id           String          @id @default(uuid())
  estudianteId String          @map("estudiante_id")
  profesorId   String          @map("profesor_id")
  tipo         TipoObservacion
  descripcion  String
  fecha        DateTime        @default(now())
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  estudiante Estudiante         @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  profesor   Profesor           @relation(fields: [profesorId], references: [id])
  vistas     ObservacionVista[]
  materiaId  String?            @map("materia_id")
  materia    Materia?           @relation(fields: [materiaId], references: [id])

  @@map("observaciones")
}

model ObservacionVista {
  id            String   @id @default(uuid())
  observacionId String   @map("observacion_id")
  padreId       String   @map("padre_id")
  fechaVisto    DateTime @default(now()) @map("fecha_visto")

  observacion Observacion @relation(fields: [observacionId], references: [id], onDelete: Cascade)
  padre       Padre       @relation(fields: [padreId], references: [id], onDelete: Cascade)

  @@unique([observacionId, padreId])
  @@map("observaciones_vistas")
}

// ─── ARCHIVOS / PDFs ─────────────────────────────────────────────────────────

model Archivo {
  id               String               @id @default(uuid())
  estudianteId     String?              @map("estudiante_id")
  subidoPorPadreId String?              @map("subido_por_padre_id")
  tipo             TipoDocumentoArchivo
  nombreOriginal   String               @map("nombre_original")
  nombreArchivo    String               @unique @map("nombre_archivo") // UUID en disco
  ruta             String
  mimeType         String               @map("mime_type")
  tamanoBytes      Int                  @map("tamano_bytes")
  descripcion      String?
  visibleParaPadre Boolean              @default(false) @map("visible_para_padre")
  createdAt        DateTime             @default(now()) @map("created_at")

  estudiante      Estudiante?             @relation(fields: [estudianteId], references: [id])
  subidoPorPadre  Padre?                  @relation(fields: [subidoPorPadreId], references: [id])
  tipoDocumentoId String?                 @map("tipo_documento_id")
  tipoDocumento   TipoDocumentoRequerido? @relation(fields: [tipoDocumentoId], references: [id])

  @@map("archivos")
}

// ─── AUDITORÍA ───────────────────────────────────────────────────────────────

model AuditLog {
  id           String          @id @default(uuid())
  usuarioId    String?         @map("usuario_id")
  accion       AccionAuditoria
  entidad      String? // nombre de la tabla afectada
  entidadId    String?         @map("entidad_id")
  datosAntes   Json?           @map("datos_antes")
  datosDespues Json?           @map("datos_despues")
  ip           String?
  userAgent    String?         @map("user_agent")
  createdAt    DateTime        @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([accion])
  @@index([createdAt])
  @@map("audit_logs")
}

model Comunicado {
  id            String   @id @default(uuid())
  titulo        String
  mensaje       String   @db.Text
  destinatario  String
  gradoId       String?  @map("grado_id")
  creadoPorId   String   @map("creado_por_id")
  totalEnviados Int      @default(0) @map("total_enviados")
  archivado     Boolean  @default(false) // <- AGREGAR ESTA LÍNEA
  createdAt     DateTime @default(now()) @map("created_at")

  grado     Grado?  @relation(fields: [gradoId], references: [id])
  creadoPor Usuario @relation("ComunicadosCreadosPor", fields: [creadoPorId], references: [id])

  @@map("comunicados")
}

model Matricula {
  id                String    @id @default(uuid())
  estudianteId      String    @unique @map("estudiante_id")
  padreId           String    @map("padre_id")
  pin               String    @map("pin")
  pinUsado          Boolean   @default(false) @map("pin_usado")
  estadoDocumentos  String    @default("PENDIENTE") @map("estado_documentos")
  fechaMatricula    DateTime  @default(now()) @map("fecha_matricula")
  verificadoPor     String?   @map("verificado_por")
  fechaVerificacion DateTime? @map("fecha_verificacion")
  observaciones     String?
  createdAt         DateTime  @default(now()) @map("created_at")

  estudiante  Estudiante @relation(fields: [estudianteId], references: [id])
  padre       Padre      @relation(fields: [padreId], references: [id])
  verificador Usuario?   @relation("MatriculasVerificadas", fields: [verificadoPor], references: [id])

  @@map("matriculas")
}

model ContactoEmergencia {
  id           String   @id @default(uuid())
  estudianteId String   @map("estudiante_id")
  nombres      String
  apellidos    String
  parentesco   String
  telefono     String
  telefono2    String?  @map("telefono2")
  orden        Int      @default(1) // 1, 2 o 3
  createdAt    DateTime @default(now()) @map("created_at")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@map("contactos_emergencia")
}

model DatosAdicionales {
  id                 String   @id @default(uuid())
  estudianteId       String   @unique @map("estudiante_id")
  eps                String?
  grupoSanguineo     String?  @map("grupo_sanguineo")
  alergias           String?  @db.Text
  condicionesMedicas String?  @map("condiciones_medicas") @db.Text
  medicamentos       String?  @db.Text
  contactoMedico     String?  @map("contacto_medico")
  telefonoMedico     String?  @map("telefono_medico")
  updatedAt          DateTime @updatedAt @map("updated_at")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@map("datos_adicionales")
}

model TipoDocumentoRequerido {
  id          String    @id @default(uuid())
  nombre      String
  descripcion String?
  obligatorio Boolean   @default(true)
  activo      Boolean   @default(true)
  orden       Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  archivos    Archivo[]

  @@map("tipos_documento_requerido")
}
