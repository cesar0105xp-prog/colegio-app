generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                    String         @id @default(uuid())
  email                 String         @unique
  passwordHash          String         @map("password_hash")
  rol                   Rol
  estado                EstadoUsuario  @default(ACTIVO)
  intentosFallidos      Int            @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime?      @map("bloqueado_hasta")
  ultimoLogin           DateTime?      @map("ultimo_login")
  tokenResetPassword    String?        @map("token_reset_password")
  tokenResetExpira      DateTime?      @map("token_reset_expira")
  refreshToken          String?        @map("refresh_token")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  perfilAdmin           Administrador?
  auditLogs             AuditLog[]
  comunicados           Comunicado[]   @relation("ComunicadosCreadosPor")
  perfilEstudiante      Estudiante?
  matriculasVerificadas Matricula[]    @relation("MatriculasVerificadas")
  perfilPadre           Padre?
  perfilProfesor        Profesor?
  perfilSecretario      Secretario?
  asistenciasRegistradas RegistroAsistencia[]
  solicitudesPermiso    SolicitudPermiso[] @relation("PadrePermisos")
  eventosCreados        EventoAgenda[]
  tareasCreadas         TareaAgenda[]
  certificadosSolicitados SolicitudCertificado[] @relation("PadreCertificados")
  comprobantesPago      ComprobantePago[] @relation("PadreComprobantes")

  @@map("usuarios")
}

model Administrador {
  id        String   @id @default(uuid())
  usuarioId String   @unique @map("usuario_id")
  nombres   String
  apellidos String
  telefono  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("administradores")
}

model Secretario {
  id        String   @id @default(uuid())
  usuarioId String   @unique @map("usuario_id")
  nombres   String
  apellidos String
  telefono  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("secretarios")
}

model Profesor {
  id              String                 @id @default(uuid())
  usuarioId       String                 @unique @map("usuario_id")
  nombres         String
  apellidos       String
  tipoDocumento   TipoDocumento          @map("tipo_documento")
  numeroDocumento String                 @unique @map("numero_documento")
  telefono        String
  especialidad    String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  actividades     Actividad[]
  materiaGrados   MateriaGradoProfesor[]
  observaciones   Observacion[]
  usuario         Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("profesores")
}

model Padre {
  id                  String             @id @default(uuid())
  usuarioId           String             @unique @map("usuario_id")
  nombres             String
  apellidos           String
  tipoDocumento       TipoDocumento      @map("tipo_documento")
  numeroDocumento     String             @unique @map("numero_documento")
  telefono            String
  telefonoAlt         String?            @map("telefono_alt")
  direccion           String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  emailContacto       String?            @map("email_contacto")
  ocupacion           String?
  archivosSubidos     Archivo[]
  matriculas          Matricula[]
  observacionesVistas ObservacionVista[]
  usuario             Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hijos               PadreEstudiante[]

  @@map("padres")
}

model Estudiante {
  id                  String               @id @default(uuid())
  usuarioId           String?              @unique @map("usuario_id")
  nombres             String
  apellidos           String
  tipoDocumento       TipoDocumento        @map("tipo_documento")
  numeroDocumento     String               @unique @map("numero_documento")
  fechaNacimiento     DateTime             @map("fecha_nacimiento")
  genero              Genero
  direccion           String?
  telefono            String?
  estado              EstadoEstudiante     @default(ACTIVO)
  foto                String?
  gradoId             String               @map("grado_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  codigoMatricula     String?              @unique @map("codigo_matricula")
  archivos            Archivo[]
  calificaciones      Calificacion[]
  contactosEmergencia ContactoEmergencia[]
  datosAdicionales    DatosAdicionales?
  grado               Grado                @relation(fields: [gradoId], references: [id])
  usuario             Usuario?             @relation(fields: [usuarioId], references: [id])
  matricula           Matricula?
  observaciones       Observacion[]
  padres              PadreEstudiante[]
  cobros              Cobro[]
  asistencias         RegistroAsistencia[]
  permisos            SolicitudPermiso[]
  certificados        SolicitudCertificado[]

  @@map("estudiantes")
}

model PadreEstudiante {
  id           String     @id @default(uuid())
  padreId      String     @map("padre_id")
  estudianteId String     @map("estudiante_id")
  parentesco   String
  esPrincipal  Boolean    @default(false) @map("es_principal")
  createdAt    DateTime   @default(now()) @map("created_at")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  padre        Padre      @relation(fields: [padreId], references: [id], onDelete: Cascade)

  @@unique([padreId, estudianteId])
  @@map("padres_estudiantes")
}

model Grado {
  id            String                 @id @default(uuid())
  nombre        String
  grupo         String
  nivel         String
  anio          Int
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  actividades   Actividad[]
  comunicados   Comunicado[]
  estudiantes   Estudiante[]
  materiaGrados MateriaGradoProfesor[]
  eventosAgenda EventoAgenda[]
  tareasAgenda  TareaAgenda[]

  @@unique([nombre, grupo, anio])
  @@map("grados")
}

model Materia {
  id            String                 @id @default(uuid())
  nombre        String                 @unique
  codigo        String?                @unique
  createdAt     DateTime               @default(now()) @map("created_at")
  actividades   Actividad[]
  materiaGrados MateriaGradoProfesor[]
  observaciones Observacion[]
  tareasAgenda  TareaAgenda[]

  @@map("materias")
}

model Periodo {
  id          String                  @id @default(uuid())
  nombre      String
  numero      Int
  anio        Int
  fechaInicio DateTime                @map("fecha_inicio")
  fechaFin    DateTime                @map("fecha_fin")
  activo      Boolean                 @default(false)
  peso        Decimal                 @default(25.00) @db.Decimal(5, 2)
  configId    String?                 @map("config_id")
  createdAt   DateTime                @default(now()) @map("created_at")
  actividades Actividad[]
  config      ConfiguracionAcademica? @relation(fields: [configId], references: [id])

  @@unique([numero, anio])
  @@map("periodos")
}

model ConfiguracionAcademica {
  id          String    @id @default(uuid())
  anio        Int       @unique
  fechaInicio DateTime  @map("fecha_inicio")
  fechaFin    DateTime  @map("fecha_fin")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  periodos    Periodo[]

  @@map("configuraciones_academicas")
}

model MateriaGradoProfesor {
  id         String   @id @default(uuid())
  materiaId  String   @map("materia_id")
  gradoId    String   @map("grado_id")
  profesorId String   @map("profesor_id")
  anio       Int
  createdAt  DateTime @default(now()) @map("created_at")
  grado      Grado    @relation(fields: [gradoId], references: [id])
  materia    Materia  @relation(fields: [materiaId], references: [id])
  profesor   Profesor @relation(fields: [profesorId], references: [id])

  @@unique([materiaId, gradoId, anio])
  @@map("materia_grado_profesor")
}

model Actividad {
  id             String         @id @default(uuid())
  nombre         String
  tipo           TipoActividad
  porcentaje     Decimal        @db.Decimal(5, 2)
  descripcion    String?
  fechaEntrega   DateTime?      @map("fecha_entrega")
  materiaId      String         @map("materia_id")
  gradoId        String         @map("grado_id")
  periodoId      String         @map("periodo_id")
  profesorId     String         @map("profesor_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  grado          Grado          @relation(fields: [gradoId], references: [id])
  materia        Materia        @relation(fields: [materiaId], references: [id])
  periodo        Periodo        @relation(fields: [periodoId], references: [id])
  profesor       Profesor       @relation(fields: [profesorId], references: [id])
  calificaciones Calificacion[]

  @@map("actividades")
}

model Calificacion {
  id            String     @id @default(uuid())
  actividadId   String     @map("actividad_id")
  estudianteId  String     @map("estudiante_id")
  valor         Decimal    @db.Decimal(5, 2)
  observacion   String?
  fechaRegistro DateTime   @default(now()) @map("fecha_registro")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  actividad     Actividad  @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  estudiante    Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([actividadId, estudianteId])
  @@map("calificaciones")
}

model Observacion {
  id           String             @id @default(uuid())
  estudianteId String             @map("estudiante_id")
  profesorId   String             @map("profesor_id")
  tipo         TipoObservacion
  descripcion  String
  fecha        DateTime           @default(now())
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  materiaId    String?            @map("materia_id")
  estudiante   Estudiante         @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  materia      Materia?           @relation(fields: [materiaId], references: [id])
  profesor     Profesor           @relation(fields: [profesorId], references: [id])
  vistas       ObservacionVista[]

  @@map("observaciones")
}

model ObservacionVista {
  id            String      @id @default(uuid())
  observacionId String      @map("observacion_id")
  padreId       String      @map("padre_id")
  fechaVisto    DateTime    @default(now()) @map("fecha_visto")
  observacion   Observacion @relation(fields: [observacionId], references: [id], onDelete: Cascade)
  padre         Padre       @relation(fields: [padreId], references: [id], onDelete: Cascade)

  @@unique([observacionId, padreId])
  @@map("observaciones_vistas")
}

model Archivo {
  id               String                  @id @default(uuid())
  estudianteId     String?                 @map("estudiante_id")
  subidoPorPadreId String?                 @map("subido_por_padre_id")
  tipo             TipoDocumentoArchivo
  nombreOriginal   String                  @map("nombre_original")
  nombreArchivo    String                  @unique @map("nombre_archivo")
  ruta             String
  mimeType         String                  @map("mime_type")
  tamanoBytes      Int                     @map("tamano_bytes")
  descripcion      String?
  visibleParaPadre Boolean                 @default(false) @map("visible_para_padre")
  createdAt        DateTime                @default(now()) @map("created_at")
  tipoDocumentoId  String?                 @map("tipo_documento_id")
  estudiante       Estudiante?             @relation(fields: [estudianteId], references: [id])
  subidoPorPadre   Padre?                  @relation(fields: [subidoPorPadreId], references: [id])
  tipoDocumento    TipoDocumentoRequerido? @relation(fields: [tipoDocumentoId], references: [id])

  @@map("archivos")
}

model AuditLog {
  id           String          @id @default(uuid())
  usuarioId    String?         @map("usuario_id")
  accion       AccionAuditoria
  entidad      String?
  entidadId    String?         @map("entidad_id")
  datosAntes   Json?           @map("datos_antes")
  datosDespues Json?           @map("datos_despues")
  ip           String?
  userAgent    String?         @map("user_agent")
  createdAt    DateTime        @default(now()) @map("created_at")
  usuario      Usuario?        @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([accion])
  @@index([createdAt])
  @@map("audit_logs")
}

model Comunicado {
  id            String   @id @default(uuid())
  titulo        String
  mensaje       String
  destinatario  String
  gradoId       String?  @map("grado_id")
  creadoPorId   String   @map("creado_por_id")
  totalEnviados Int      @default(0) @map("total_enviados")
  createdAt     DateTime @default(now()) @map("created_at")
  archivado     Boolean  @default(false)
  creadoPor     Usuario  @relation("ComunicadosCreadosPor", fields: [creadoPorId], references: [id])
  grado         Grado?   @relation(fields: [gradoId], references: [id])

  @@map("comunicados")
}

model Matricula {
  id                String     @id @default(uuid())
  estudianteId      String     @unique @map("estudiante_id")
  padreId           String     @map("padre_id")
  pin               String     @map("pin")
  pinUsado          Boolean    @default(false) @map("pin_usado")
  estadoDocumentos  String     @default("PENDIENTE") @map("estado_documentos")
  fechaMatricula    DateTime   @default(now()) @map("fecha_matricula")
  verificadoPor     String?    @map("verificado_por")
  fechaVerificacion DateTime?  @map("fecha_verificacion")
  observaciones     String?
  createdAt         DateTime   @default(now()) @map("created_at")
  estudiante        Estudiante @relation(fields: [estudianteId], references: [id])
  padre             Padre      @relation(fields: [padreId], references: [id])
  verificador       Usuario?   @relation("MatriculasVerificadas", fields: [verificadoPor], references: [id])

  @@map("matriculas")
}

model ContactoEmergencia {
  id           String     @id @default(uuid())
  estudianteId String     @map("estudiante_id")
  nombres      String
  apellidos    String
  parentesco   String
  telefono     String
  telefono2    String?    @map("telefono2")
  orden        Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@map("contactos_emergencia")
}

model DatosAdicionales {
  id                 String     @id @default(uuid())
  estudianteId       String     @unique @map("estudiante_id")
  eps                String?
  grupoSanguineo     String?    @map("grupo_sanguineo")
  alergias           String?
  condicionesMedicas String?    @map("condiciones_medicas")
  medicamentos       String?
  contactoMedico     String?    @map("contacto_medico")
  telefonoMedico     String?    @map("telefono_medico")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  estudiante         Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@map("datos_adicionales")
}

model ConceptoPago {
  id          String   @id @default(uuid())
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.VarChar(300)
  monto       Decimal  @db.Decimal(10, 2)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  cobros      Cobro[]

  @@map("conceptos_pago")
}

model Cobro {
  id            String       @id @default(uuid())
  estudianteId  String       @map("estudiante_id")
  conceptoId    String       @map("concepto_id")
  anio          Int
  mes           Int
  montoCobrado  Decimal      @db.Decimal(10, 2) @map("monto_cobrado")
  estadoPago    EstadoPago   @default(PENDIENTE) @map("estado_pago")
  fechaPago     DateTime?    @map("fecha_pago")
  metodoPago    MetodoPago?  @map("metodo_pago")
  observaciones String?      @db.VarChar(500)
  registradoPor String       @map("registrado_por")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  estudiante    Estudiante   @relation(fields: [estudianteId], references: [id])
  concepto      ConceptoPago @relation(fields: [conceptoId], references: [id])
  comprobantes  ComprobantePago[]

  @@index([estudianteId])
  @@index([estadoPago])
  @@index([mes, anio])
  @@map("cobros")
}

model ComprobantePago {
  id                String            @id @default(uuid())
  cobroId           String            @map("cobro_id")
  padreId           String            @map("padre_id")
  archivoUrl        String            @map("archivo_url")
  nombreOriginal    String            @map("nombre_original")
  observaciones     String?           @db.VarChar(200)
  estado            EstadoComprobante @default(PENDIENTE_VERIFICACION)
  motivoRechazo     String?           @db.VarChar(300) @map("motivo_rechazo")
  verificadoPor     String?           @map("verificado_por")
  fechaVerificacion DateTime?         @map("fecha_verificacion")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  cobro             Cobro             @relation(fields: [cobroId], references: [id])
  padre             Usuario           @relation("PadreComprobantes", fields: [padreId], references: [id])

  @@index([cobroId])
  @@index([estado])
  @@map("comprobantes_pago")
}

model RegistroAsistencia {
  id           String           @id @default(uuid())
  estudianteId String           @map("estudiante_id")
  profesorId   String           @map("profesor_id")
  fecha        DateTime         @db.Date
  estadoManana EstadoAsistencia @default(PRESENTE) @map("estado_manana")
  estadoTarde  EstadoAsistencia @default(PRESENTE) @map("estado_tarde")
  observacion  String?          @db.VarChar(300)
  justificada  Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  estudiante   Estudiante       @relation(fields: [estudianteId], references: [id])
  profesor     Usuario          @relation(fields: [profesorId], references: [id])

  @@unique([estudianteId, fecha])
  @@index([estudianteId])
  @@index([fecha])
  @@map("registros_asistencia")
}

model SolicitudPermiso {
  id              String        @id @default(uuid())
  estudianteId    String        @map("estudiante_id")
  padreId         String        @map("padre_id")
  fechaPermiso    DateTime      @db.Date @map("fecha_permiso")
  motivoCodigo    MotivoPermiso @map("motivo_codigo")
  descripcion     String        @db.VarChar(500)
  estado          EstadoPermiso @default(PENDIENTE)
  revisadoPor     String?       @map("revisado_por")
  fechaRevision   DateTime?     @map("fecha_revision")
  observacionResp String?       @db.VarChar(300) @map("observacion_resp")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  estudiante      Estudiante    @relation(fields: [estudianteId], references: [id])
  padre           Usuario       @relation("PadrePermisos", fields: [padreId], references: [id])

  @@unique([estudianteId, fechaPermiso])
  @@index([estudianteId])
  @@index([estado])
  @@map("solicitudes_permiso")
}

model EventoAgenda {
  id          String     @id @default(uuid())
  titulo      String     @db.VarChar(100)
  descripcion String?    @db.VarChar(800)
  fechaInicio DateTime   @map("fecha_inicio")
  fechaFin    DateTime?  @map("fecha_fin")
  tipoEvento  TipoEvento @map("tipo_evento")
  gradoId     String?    @map("grado_id")
  creadorId   String     @map("creador_id")
  visible     Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  grado       Grado?     @relation(fields: [gradoId], references: [id])
  creador     Usuario    @relation(fields: [creadorId], references: [id])

  @@index([fechaInicio])
  @@index([gradoId])
  @@map("eventos_agenda")
}

model TareaAgenda {
  id           String   @id @default(uuid())
  titulo       String   @db.VarChar(100)
  descripcion  String?  @db.VarChar(800)
  fechaEntrega DateTime @map("fecha_entrega")
  materiaId    String   @map("materia_id")
  gradoId      String   @map("grado_id")
  profesorId   String   @map("profesor_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  materia      Materia  @relation(fields: [materiaId], references: [id])
  grado        Grado    @relation(fields: [gradoId], references: [id])
  profesor     Usuario  @relation(fields: [profesorId], references: [id])

  @@index([fechaEntrega])
  @@index([gradoId])
  @@map("tareas_agenda")
}

model SolicitudCertificado {
  id              String            @id @default(uuid())
  estudianteId    String            @map("estudiante_id")
  padreId         String            @map("padre_id")
  tipoCertificado TipoCertificado   @map("tipo_certificado")
  estado          EstadoCertificado @default(PENDIENTE)
  observaciones   String?           @db.VarChar(300)
  archivoUrl      String?           @map("archivo_url")
  datosSnapshot   Json?             @map("datos_snapshot")
  procesadoPor    String?           @map("procesado_por")
  fechaProcesado  DateTime?         @map("fecha_procesado")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  estudiante      Estudiante        @relation(fields: [estudianteId], references: [id])
  padre           Usuario           @relation("PadreCertificados", fields: [padreId], references: [id])

  @@index([estudianteId])
  @@index([estado])
  @@map("solicitudes_certificado")
}

model TipoDocumentoRequerido {
  id          String    @id @default(uuid())
  nombre      String
  descripcion String?
  obligatorio Boolean   @default(true)
  activo      Boolean   @default(true)
  orden       Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  archivos    Archivo[]

  @@map("tipos_documento_requerido")
}

enum Rol {
  ADMINISTRADOR
  SECRETARIO
  PROFESOR
  PADRE
  ESTUDIANTE
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum TipoDocumento {
  CC
  TI
  RC
  CE
  PASAPORTE
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
}

enum EstadoEstudiante {
  ACTIVO
  INACTIVO
  RETIRADO
  GRADUADO
}

enum TipoActividad {
  TAREA
  TALLER
  EXAMEN
  QUIZ
  PROYECTO
  EXPOSICION
  PARTICIPACION
}

