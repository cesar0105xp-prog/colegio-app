DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/colegio_db"
JWT_SECRET="reemplazar-por-un-secreto-aleatorio-de-minimo-64-caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="reemplazar-por-otro-secreto-aleatorio-diferente-de-minimo-64-caracteres"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=correo@ejemplo.com
MAIL_PASS=reemplazar-por-app-password-de-gmail
MAIL_FROM="Portal Escolar <correo@ejemplo.com>"
SEED_ADMIN_PASSWORD="cambiar-por-una-contrasena-segura"
BCRYPT_ROUNDS=12

# WhatsApp (Twilio) — deja vacío TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN para que el
# sistema funcione en "modo desarrollo": los mensajes se registran en el log en
# vez de enviarse. Para envíos reales, crea una cuenta en https://www.twilio.com,
# activa el WhatsApp Sandbox (o un número de WhatsApp Business aprobado) y copia
# el Account SID / Auth Token del panel de Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
