NODE_ENV=production
PORT=3001

# Cadena de conexión de la base de datos PostgreSQL de producción.
# Usa un usuario con permisos mínimos (no superuser) y nunca expongas el
# puerto 5432 públicamente — solo el backend debe poder alcanzarlo.
DATABASE_URL="postgresql://usuario_app:contrasena@host-produccion:5432/colegio_db"

# Genera cada secreto por separado con: openssl rand -base64 64
JWT_SECRET="reemplazar-por-un-secreto-aleatorio-de-minimo-64-caracteres"
JWT_REFRESH_SECRET="reemplazar-por-otro-secreto-aleatorio-diferente-de-minimo-64-caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Dominio real del frontend en producción (sin barra final). Controla CORS
# y se usa para armar enlaces en los correos que envía el backend.
FRONTEND_URL="https://portal.liceosanmarcos.edu.co"

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=correo@ejemplo.com
MAIL_PASS=reemplazar-por-app-password-de-gmail
MAIL_FROM="Portal Escolar <correo@ejemplo.com>"

# WhatsApp (Twilio). Account SID / Auth Token del panel de Twilio, y el número
# de WhatsApp Business aprobado (o el sandbox mientras se aprueba). Si se dejan
# vacíos, los mensajes solo se registran en el log — no se envían.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Costo de bcrypt: 12 es el mínimo recomendado en producción.
BCRYPT_ROUNDS=12

# Solo se usa si vuelves a correr `npm run seed` contra producción
# (normalmente no debería ser necesario después del primer despliegue).
SEED_ADMIN_PASSWORD="cambiar-por-una-contrasena-segura"
